# セル andon-<slug> に入る口（bin/bootstrap host-install が番号を埋めて ~/.ssh/config.d/ に置く）。
# 鍵はセルの repo の .ssh/authorized_keys に公開鍵を置く（コンテナの中で sshd が読む）。
Host andon-<slug>
  HostName 127.0.0.1
  Port <ssh-port>
  User andon
  # portless の名前（http://<app>.<slug>.localhost:<portless-port>）を手元のブラウザから引く
  LocalForward <portless-port> 127.0.0.1:<portless-port>
