{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  },
  "includeCoAuthoredBy": false,
  "autoMemoryEnabled": false,
  "language": "Japanese",
  "permissions": {
    "allow": [
      "Bash(actionlint:*)",
      "Bash(cat:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(ghalint:*)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git diff *--output*)",
      "Bash(git diff *--ext-diff*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "Bash(git log *--ext-diff*)",
      "Bash(git show *--ext-diff*)",
      "Edit(//workspace/andon.toml)",
      "Edit(//workspace/AGENTS.md)",
      "Edit(//workspace/gate.local.json)",
      "Edit(//workspace/templates.local/**)",
      "Edit(//workspace/local/**)",
      "Edit(//workspace/bin/**)",
      "Edit(//workspace/projects/*/project.json)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/andon/hooks/user-prompt-submit",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/andon/hooks/stop",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/opt/andon/lib/andon/statusline",
    "padding": 0
  }
}
