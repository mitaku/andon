{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto"
  },
  "attribution": false,
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": "/workspace/memory",
  "language": "Japanese",
  "allowManagedPermissionRulesOnly": true,
  "permissions": {
    "allow": [
      "Bash(actionlint:*)",
      "Bash(cat:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(ghalint:*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push --force-with-lease)",
      "Bash(git push --force-with-lease origin *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git diff *--output*)",
      "Bash(git diff *--ext-diff*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "Bash(git log *--ext-diff*)",
      "Bash(git show *--ext-diff*)",
      "Bash(git push *--force-with-lease* main)",
      "Bash(git push *--force-with-lease* main *)",
      "Bash(git push * main *--force-with-lease*)",
      "Bash(git push *--force-with-lease*+main)",
      "Bash(git push *--force-with-lease*+main *)",
      "Bash(git push *+main *--force-with-lease*)",
      "Bash(git push *--force-with-lease*:main)",
      "Bash(git push *--force-with-lease*:main *)",
      "Bash(git push *:main *--force-with-lease*)",
      "Bash(git push *--force-with-lease*/heads/main)",
      "Bash(git push *--force-with-lease*/heads/main *)",
      "Bash(git push */heads/main *--force-with-lease*)",
      "Bash(git push *--force-with-lease*--all*)",
      "Bash(git push *--all*--force-with-lease*)",
      "Bash(git push *--force-with-lease*--mirror*)",
      "Bash(git push *--mirror*--force-with-lease*)",
      "Bash(git push *--force-with-lease* --force)",
      "Bash(git push *--force-with-lease* --force *)",
      "Bash(git push *--force-with-lease* -f)",
      "Bash(git push *--force-with-lease* -f *)",
      "Bash(git push *--force-with-lease* --delete)",
      "Bash(git push *--force-with-lease* --delete *)",
      "Bash(git push *--force-with-lease* -d)",
      "Bash(git push *--force-with-lease* -d *)",
      "Bash(git push *--force-with-lease* --prune)",
      "Bash(git push *--force-with-lease* --prune *)",
      "Bash(git push *--force-with-lease* --tags)",
      "Bash(git push *--force-with-lease* --tags *)",
      "Bash(git push *--force-with-lease* --follow-tags)",
      "Bash(git push *--force-with-lease* --follow-tags *)",
      "Bash(git push *--force-with-lease* tag)",
      "Bash(git push *--force-with-lease* tag *)",
      "Bash(git push *--force-with-lease* :**)",
      "Bash(git push *--force-with-lease* +:**)",
      "Bash(git push *--force-with-lease*refs/tags/*)",
      "Bash(git push --force-with-lease origin * *)",
      "Bash(git push --force-with-lease origin -*)",
      "Bash(git push --force-with-lease origin +*)",
      "Edit(//workspace/andon.toml)",
      "Edit(//workspace/AGENTS.md)",
      "Edit(//workspace/AGENTS.worker.md)",
      "Edit(//workspace/gate.local.json)",
      "Edit(//workspace/templates.local/**)",
      "Edit(//workspace/local/**)",
      "Edit(//workspace/bin/**)",
      "Edit(//workspace/projects/*/project.json)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/andon/hooks/user-prompt-submit",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/andon/hooks/stop",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "/opt/andon/hooks/stop-wait",
            "timeout": 7200,
            "asyncRewake": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/andon/hooks/stop-failure",
            "timeout": 600,
            "asyncRewake": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/opt/andon/lib/andon/statusline",
    "padding": 0
  }
}
