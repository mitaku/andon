# Codex の execpolicy の rules。boot が ~/.codex/rules/andon.rules に写す（docs/image.md の「Codex の承認と sandbox」）。
# managed settings（settings.json）の permissions.deny のうち、コマンドの頭で引く線（Bash(<コマンド>:*)）と同じ線。
# 一覧を変えたら settings.json も直す（tests/package.sh が突き合わせる）。
prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "マージは人がする（担当・レビュアーは PR を出して止まる）",
    match = [["gh", "pr", "merge", "1", "--squash"]],
    not_match = [["gh", "pr", "view", "1"]],
)
