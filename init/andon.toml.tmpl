# セルの設定（人が書く）。andon init が作り、以後 Andon は追従しない。
# セルの repo の名前は <slug>-cell（ADR-0005 前提 3 より前に作ったものは andon-<slug>）。

# セルの名前。compose の project は andon-<slug>、コンテナのホスト名は <slug>。
slug = "{{.Slug}}"

# セルのオーナー（git の author の email）。projects/<project>/project.json（委譲・書いてよい repo）は、
# それを最後に変えた commit の author がこれと一致するときだけ信じる（空なら委譲は無いものとして読む）。
owner = "{{.Owner}}"
