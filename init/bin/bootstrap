#!/usr/bin/env bash
# セルの入口（薄い入口）。ホストに要るのは docker と bash だけ。
#
# 打つたびに、セルの image（andon-<slug>:local）から本体 /opt/andon/host/bootstrap を .andon/bootstrap に取り出し、
# 引数をそのまま渡して走らせる。sub-command と使い方は本体が持つ（bin/bootstrap --help）。
# image が無いか、image に本体が無ければ、先に 1 回だけ焼く。
#
#   ANDON_ENTRY_BODY=<本体のファイル> bin/bootstrap …
#                    image を見ず、焼かず、取り出さずに、そのファイルを本体として走らせる（docs/operate.md の 3）
#   bin/bootstrap --dry-run …
#                    docker を打たず、何も書かずに、焼く・取り出す・走らせるの 3 つを出す
#
# この入口は Andon を上げても変わらない。動きを変えるときは entry の番号を上げる（本体が古い入口を断る。ADR-0048）。
set -euo pipefail

# 入口の形の番号。本体へ ANDON_ENTRY で渡す
entry=1

# 名指しの本体は、打った場所からのパスで読む（このあと根へ移る）
if [ -n "${ANDON_ENTRY_BODY:-}" ] && [[ $ANDON_ENTRY_BODY != /* ]]; then
  ANDON_ENTRY_BODY=$PWD/$ANDON_ENTRY_BODY
fi
cd "$(dirname "$0")/.."

# 引数は本体へそのまま渡す（ここでは読むだけ）
dry=0
help=0
case "${1:-}" in
  --dry-run) dry=1 ;;
  -h | --help | help) help=1 ;;
esac

die() { echo "✗ $*" >&2; exit 1; }

# andon.toml の key = "value" の値（TOML の1行の文字列だけを読む）
toml() { sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" andon.toml | head -n 1; }

[ -f andon.toml ] || die "andon.toml が無い（andon init で作ったセルの repo の中で打つ）"
slug=$(toml slug)
case "$slug" in
  '' | *[!a-z0-9-]* | -*) die "andon.toml の slug が無いか、英小文字・数字・- でない: '$slug'" ;;
esac
from=$(sed -n 's/^FROM[[:space:]]\{1,\}\([^[:space:]]*\).*/\1/p' Dockerfile | head -n 1)
case "$from" in
  '' | *'<'* | *'>'*) die "Dockerfile の FROM を埋める（いま: '$from'。例 ghcr.io/<owner>/andon:<バージョン>）" ;;
esac
image=andon-$slug:local
export ANDON_ENTRY=$entry

# 名指しの本体（ANDON_ENTRY_BODY）か、検査の偽の image の根（ANDON_IMAGE_ROOT）の本体があれば、docker を見ずにそれを走らせる
body=${ANDON_ENTRY_BODY:-}
if [ -z "$body" ] && [ -n "${ANDON_IMAGE_ROOT:-}" ]; then
  body=$ANDON_IMAGE_ROOT/opt/andon/host/bootstrap
fi
if [ -n "$body" ]; then
  [ -f "$body" ] || die "名指しの本体 $body が無い（ANDON_ENTRY_BODY に本体のファイルを渡す。例 <andon の checkout>/package/host/bootstrap）"
  # 薄い入口を名指すと、入口が自分を走らせ続ける
  if grep -qx 'entry=[0-9]*' "$body"; then
    die "名指しの $body は薄い入口で、本体でない（本体は <andon の checkout>/package/host/bootstrap）"
  fi
  if [ -n "${ANDON_ENTRY_BODY:-}" ]; then
    echo "[andon-$slug] image の本体でなく、名指しの $body で動く" >&2
  fi
  exec bash "$body" "$@"
fi

if [ "$dry" = 1 ]; then
  printf '+ docker build -t %q %q\n' "$image" "$PWD"
  printf '+ docker cp %q .andon/bootstrap\n' "<docker create $image>:/opt/andon/host/bootstrap"
  printf '+ bash .andon/bootstrap'
  printf ' %q' "$@"
  printf '\n'
  echo "（焼くのは image が無いか、image に本体が無いときだけ。本体が打つものも見るなら ANDON_ENTRY_BODY に本体のファイルを名指しする）" >&2
  exit 0
fi

# help は image を焼かない。本体を読めなければ短い案内を出す
short_help() {
  echo "セルの入口（薄い入口）。sub-command と使い方は、image の中の本体が出す。"
  echo "いまは本体を読めない: $1"
  echo "初めは引数なしで bin/bootstrap を打つ（image を焼いて起動する）。"
  echo "image を見ずに本体を名指すなら: ANDON_ENTRY_BODY=<andon の checkout>/package/host/bootstrap bin/bootstrap --help"
  exit 0
}

docker_ok=1
if ! command -v docker >/dev/null 2>&1; then
  docker_ok=0
elif ! docker info >/dev/null 2>&1; then
  docker_ok=0
fi
if [ "$docker_ok" = 0 ]; then
  if [ "$help" = 1 ]; then short_help "docker に繋がらない"; fi
  command -v docker >/dev/null 2>&1 || die "docker が無い。セルはホストに docker と bash だけを求める"
  die "docker デーモンに繋がらない（起動しているか確かめる）"
fi

has_image() { docker image inspect "$image" >/dev/null 2>&1; }

# .andon/ に書けないことを、本体が無いことと取り違えない（取り違えると焼き直して FROM の案内を出す）
if ! mkdir -p .andon 2>/dev/null || [ ! -w .andon ]; then
  die "$PWD/.andon/ に書けない（セルの repo を打つ利用者の持ち物にする。sudo で打ったなら持ち主を戻す）"
fi

# extract_body は image の本体を .andon/bootstrap に取り出す。打つたびに取り出し、前に取り出したものは走らせない。
# 一時の名前はプロセスごとに変え、mv で置き換える（走っている本体が読むファイルを書き換えない。ADR-0048 決めたこと 4）
extract_body() {
  local cid part
  part=$(mktemp .andon/bootstrap.XXXXXX) || die "$PWD/.andon/ に一時のファイルを作れない"
  if ! cid=$(docker create "$image" 2>/dev/null); then
    rm -f "$part"
    return 1
  fi
  if ! docker cp "$cid:/opt/andon/host/bootstrap" "$part" >/dev/null 2>&1; then
    docker rm "$cid" >/dev/null 2>&1 || true
    rm -f "$part"
    return 1
  fi
  docker rm "$cid" >/dev/null 2>&1 || true
  mv "$part" .andon/bootstrap || die "$PWD/.andon/bootstrap を置き換えられない"
}

stuck() {
  die "本体を取り出せない: $1
  Dockerfile の FROM を、本体を持つバージョン以上に上げて打ち直す。
  image を見ずに直すなら、本体のファイルを名指しして打つ: ANDON_ENTRY_BODY=<andon の checkout>/package/host/bootstrap bin/bootstrap …（docs/operate.md の 3）"
}

built=0
bake() {
  echo "[andon-$slug] $1ので、本体を取り出すために $image を焼く" >&2
  if ! docker build -t "$image" "$PWD"; then
    stuck "$image を焼けなかった"
  fi
  built=1
}

if ! has_image; then
  if [ "$help" = 1 ]; then short_help "$image が無い"; fi
  bake "image が無い"
fi
if ! extract_body; then
  if [ "$help" = 1 ]; then short_help "$image に本体が無い"; fi
  if [ "$built" = 1 ]; then stuck "$image に本体が無い"; fi
  bake "$image に本体が無い"
  extract_body || stuck "焼き直した $image にも本体が無い"
fi
exec bash .andon/bootstrap "$@"
