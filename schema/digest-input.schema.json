{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andon.example.com/schema/digest-input/1",
  "title": "Digest input",
  "description": "issues/<id>/library/digest/input.json: what `andon digest collect <id>` read for one digest (ADR-0044), from the ledger, the dispatcher's records and GitHub's merged pull request list. Written only by that command, after hiding secret shapes. Read by the digest's worker and by `andon digest build`, which draws every count, list and bar from it. Only these keys.",
  "type": "object",
  "required": [
    "version",
    "project",
    "issue",
    "title",
    "at",
    "since",
    "until",
    "previous",
    "truncated",
    "issues",
    "waiting",
    "concerns",
    "numbers",
    "next",
    "redacted",
    "skipped"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "The format version.",
      "const": 1
    },
    "project": {
      "description": "The project slug.",
      "type": "string",
      "minLength": 1
    },
    "issue": {
      "description": "The digest's own issue.",
      "$ref": "#/$defs/id"
    },
    "title": {
      "description": "The digest issue's title (the routine's title): the HTML heading and the message's first line.",
      "type": "string",
      "minLength": 1
    },
    "at": {
      "description": "When it was collected.",
      "$ref": "#/$defs/time"
    },
    "since": {
      "description": "The start of the period: the end of the previous sent digest, else 24 hours before, never more than 7 days before.",
      "$ref": "#/$defs/time"
    },
    "until": {
      "description": "The end of the period (the same as at).",
      "$ref": "#/$defs/time"
    },
    "previous": {
      "description": "The newest earlier digest of the same routine whose sent.json has every destination done, or null when there is none.",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "issue",
            "until",
            "sent_at"
          ],
          "additionalProperties": false,
          "properties": {
            "issue": {
              "description": "That digest's issue.",
              "$ref": "#/$defs/id"
            },
            "until": {
              "description": "That digest's period end.",
              "$ref": "#/$defs/time"
            },
            "sent_at": {
              "description": "When its last destination was done.",
              "$ref": "#/$defs/time"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "truncated": {
      "description": "The previous sent digest ended more than 7 days before, so the period was cut at 7 days.",
      "type": "boolean"
    },
    "issues": {
      "description": "Issues (not reviewer sub-issues, not digests of the same routine) that were done or whose pull request was merged in the period, by id. Themes and concerns may point only to these.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "uniqueKeys": [
        "id"
      ]
    },
    "waiting": {
      "description": "The output of `andon waiting --json` at the same time (schema/waiting.schema.json; collect and build check it against that schema).",
      "type": "object",
      "required": [
        "version",
        "at",
        "project",
        "slots",
        "items"
      ]
    },
    "concerns": {
      "description": "What went wrong in the period, found by the command.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/concern"
      }
    },
    "numbers": {
      "description": "The last 7 days and the 7 days before, counted the same way as `andon measure`.",
      "type": "object",
      "required": [
        "days",
        "current",
        "previous"
      ],
      "additionalProperties": false,
      "properties": {
        "days": {
          "description": "The last 7 UTC days, oldest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/day"
          }
        },
        "current": {
          "description": "The last 7 UTC days (the day of until and the 6 before).",
          "$ref": "#/$defs/week"
        },
        "previous": {
          "description": "The 7 UTC days before those.",
          "$ref": "#/$defs/week"
        }
      }
    },
    "next": {
      "description": "What comes next.",
      "type": "object",
      "required": [
        "ready",
        "observations",
        "routines"
      ],
      "additionalProperties": false,
      "properties": {
        "ready": {
          "description": "Worker issues waiting to be launched: todo, every after done, not_before passed.",
          "type": "integer",
          "minimum": 0
        },
        "observations": {
          "description": "Observation issues (parent is a Chief Engineer issue) not done whose not_before is within 7 days.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "not_before"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "The observation issue.",
                "$ref": "#/$defs/id"
              },
              "title": {
                "description": "Its title.",
                "type": "string"
              },
              "not_before": {
                "description": "YYYY-MM-DD.",
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "routines": {
          "description": "The ledger's routines with a schedule, by name.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "title",
              "next"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "The routine's name (routines/<name>.yaml).",
                "type": "string",
                "minLength": 1
              },
              "title": {
                "description": "The routine's title, or empty.",
                "type": "string"
              },
              "next": {
                "description": "The schedule's next time after until, or null when it is paused or names no time.",
                "anyOf": [
                  {
                    "$ref": "#/$defs/time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "decided": {
      "description": "What was decided in the owner's place in the period: marked decision lines that entered main, and the Chief of Staff's triage, retro and scope answers. `andon digest collect` always writes it; an input from an older andon has none, and build says it was not collected.",
      "type": "object",
      "required": [
        "decisions",
        "triage",
        "retro",
        "answers",
        "mains"
      ],
      "additionalProperties": false,
      "properties": {
        "decisions": {
          "description": "Marked decision lines that main's docs/ gained over the period (the tree before the period against the tree at its end), by repository, document and line.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "triage": {
          "description": "Triage records whose issue was done in the period, oldest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/triage"
          }
        },
        "retro": {
          "description": "Retro records applied in the period, oldest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/retro"
          }
        },
        "answers": {
          "description": "Scope questions answered from a role's terminal in the period, oldest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/answer"
          }
        },
        "mains": {
          "description": "How far main was read, by repository. The next digest compares from here, so a commit pushed later with an older committer time is not lost.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/main_read"
          }
        }
      }
    },
    "redacted": {
      "description": "How many secret shapes were hidden.",
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "description": "What could not be read (not counted as zero).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "description": "What was not read (a path from the project root, or a name).",
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "description": "Why, one line.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "time": {
      "description": "UTC time, YYYY-MM-DDTHH:MM:SSZ.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "date": {
      "description": "A day, YYYY-MM-DD.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "id": {
      "description": "An issue id.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "pr": {
      "description": "A GitHub pull request.",
      "type": "string",
      "pattern": "^https://github\\.com/[!-.0-~]+/[!-.0-~]+/pull/[1-9][0-9]*$"
    },
    "issue": {
      "description": "One issue of the period.",
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "done_at",
        "pr",
        "merged_at",
        "merged_by",
        "tier",
        "grant",
        "retro"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The issue.",
          "$ref": "#/$defs/id"
        },
        "title": {
          "description": "Its title.",
          "type": "string"
        },
        "status": {
          "description": "The issue's status now.",
          "type": "string",
          "minLength": 1
        },
        "done_at": {
          "description": "When it last moved to done in the period, or null.",
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "pr": {
          "description": "report.json's pr, or null.",
          "anyOf": [
            {
              "$ref": "#/$defs/pr"
            },
            {
              "type": "null"
            }
          ]
        },
        "merged_at": {
          "description": "outcome.json's merged_at when it is in the period, else null.",
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "merged_by": {
          "description": "dispatcher: a gate record in outcome.json says the dispatcher merged it. person: merged without that. null: not merged in the period.",
          "anyOf": [
            {
              "enum": [
                "dispatcher",
                "person"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "tier": {
          "description": "The merged head's gate tier, else the last gate record's, else null.",
          "anyOf": [
            {
              "enum": [
                "A",
                "B",
                "C"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "grant": {
          "description": "The named grant id that let the dispatcher merge it (the gate record's delegation.grant), or null.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^d[1-9][0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retro": {
          "description": "Its parent is a retro issue (a fix the retro cut).",
          "type": "boolean"
        }
      }
    },
    "concern": {
      "description": "One thing that went wrong. stalled: the dispatcher told of an error or stalled worker. gate_fix: the gate sent the work back. review_over: a review was asked past review_rounds. ci_failed: main's CI fails now (the signal record). revert: a revert pull request was merged. estimate: the worked time passed twice the estimate.",
      "type": "object",
      "required": [
        "kind",
        "issue",
        "title",
        "at",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "What kind of thing went wrong (see above). stalled, ci_failed and revert are failures that stopped something.",
          "enum": [
            "stalled",
            "gate_fix",
            "review_over",
            "ci_failed",
            "revert",
            "estimate"
          ]
        },
        "issue": {
          "description": "The issue, or null when there is none (main's CI).",
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "description": "One line for a person: the issue's title, the CI run's or the revert's title.",
          "type": "string"
        },
        "at": {
          "description": "When it happened (the last time seen).",
          "$ref": "#/$defs/time"
        },
        "url": {
          "description": "Where to read it, or null.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://[!-~]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "decision": {
      "description": "One numbered line of a document's decisions section whose bold sentence carries a parenthesis naming the Chief Engineer.",
      "type": "object",
      "required": [
        "text",
        "mark",
        "repo",
        "commit",
        "path",
        "line",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "description": "The bold sentence without that parenthesis.",
          "type": "string"
        },
        "mark": {
          "description": "Inside the parenthesis, as written.",
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "description": "The repository, as issue.yaml's repo.",
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "description": "The last commit that entered main in the period: path and line are of its tree.",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "description": "The document, from the repository root.",
          "type": "string",
          "minLength": 1
        },
        "line": {
          "description": "The line in that commit's document.",
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "description": "The line on GitHub, or null for another host.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://[!-~]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "triage": {
      "description": "One applied triage.",
      "type": "object",
      "required": [
        "issue",
        "title",
        "at",
        "closed",
        "cut",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "issue": {
          "description": "The issue.",
          "$ref": "#/$defs/id"
        },
        "title": {
          "description": "Its title.",
          "type": "string"
        },
        "at": {
          "description": "When the triage issue was done (the record has no time of its own).",
          "$ref": "#/$defs/time"
        },
        "closed": {
          "description": "Items it closed.",
          "type": "integer",
          "minimum": 0
        },
        "cut": {
          "description": "Issues it cut to fix or bundle items.",
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "description": "The record, from the project root.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retro": {
      "description": "One applied retro.",
      "type": "object",
      "required": [
        "issue",
        "title",
        "at",
        "fix",
        "dropped",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "issue": {
          "description": "The issue.",
          "$ref": "#/$defs/id"
        },
        "title": {
          "description": "Its title.",
          "type": "string"
        },
        "at": {
          "description": "retro-applied.json's applied_at.",
          "$ref": "#/$defs/time"
        },
        "fix": {
          "description": "Patterns it decided to fix.",
          "type": "integer",
          "minimum": 0
        },
        "dropped": {
          "description": "Patterns it dropped.",
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "description": "The record, from the project root.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "answer": {
      "description": "One answered scope question.",
      "type": "object",
      "required": [
        "issue",
        "title",
        "n",
        "question",
        "answer",
        "at",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "issue": {
          "description": "The issue.",
          "$ref": "#/$defs/id"
        },
        "title": {
          "description": "Its title.",
          "type": "string"
        },
        "n": {
          "description": "The question's number.",
          "type": "integer",
          "minimum": 1
        },
        "question": {
          "description": "The question, one line.",
          "type": "string"
        },
        "answer": {
          "description": "The answer, as the ledger has it.",
          "type": "string"
        },
        "at": {
          "description": "When it was answered.",
          "$ref": "#/$defs/time"
        },
        "path": {
          "description": "The record, from the project root.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "main_read": {
      "description": "One repository's main as read.",
      "type": "object",
      "required": [
        "repo",
        "commit"
      ],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "description": "The repository, as issue.yaml's repo.",
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "description": "The last commit read.",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "day": {
      "description": "One UTC day.",
      "type": "object",
      "required": [
        "date",
        "merged",
        "auto"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "The UTC day.",
          "$ref": "#/$defs/date"
        },
        "merged": {
          "description": "Ledger pull requests merged that day.",
          "type": "integer",
          "minimum": 0
        },
        "auto": {
          "description": "Of those, merged by the dispatcher.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "week": {
      "description": "Seven UTC days, counted by `andon measure` (merged pull requests, auto merges, closed issues, the median lead time, the mean time a question stayed open, the issues' tokens).",
      "type": "object",
      "required": [
        "since",
        "until",
        "merged",
        "auto",
        "closed",
        "lead_time_hours",
        "question_open_hours",
        "tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "since": {
          "description": "The first UTC day.",
          "$ref": "#/$defs/date"
        },
        "until": {
          "description": "The last UTC day (included).",
          "$ref": "#/$defs/date"
        },
        "merged": {
          "description": "Ledger pull requests merged.",
          "type": "integer",
          "minimum": 0
        },
        "auto": {
          "description": "Of those, merged by the dispatcher.",
          "type": "integer",
          "minimum": 0
        },
        "closed": {
          "description": "Issues closed (moved to done).",
          "type": "integer",
          "minimum": 0
        },
        "lead_time_hours": {
          "description": "The median hours from the issue's birth to its merge, or null when none was merged.",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "question_open_hours": {
          "description": "The mean hours a question stayed open, or null when none was open.",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens": {
          "description": "Input, output and cache tokens of the issues with a session record, or null when none had one.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
