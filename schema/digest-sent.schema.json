{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andon.example.com/schema/digest-sent/1",
  "title": "Digest sent",
  "description": "issues/<id>/library/digest/sent.json: where `andon digest send <id>` put one digest, one entry per destination (ADR-0044 decisions 15 and 16). Written only by that command. A done destination is not sent again; a failed one is sent again on the next run. Read by `andon digest collect`, which starts the next period at the newest digest whose destinations are all done. Only these keys.",
  "type": "object",
  "required": [
    "issue",
    "since",
    "until",
    "destinations"
  ],
  "additionalProperties": false,
  "properties": {
    "issue": {
      "description": "The digest's issue.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "since": {
      "description": "The digest's period start (input.json's since).",
      "$ref": "#/$defs/time"
    },
    "until": {
      "description": "The digest's period end (input.json's until).",
      "$ref": "#/$defs/time"
    },
    "destinations": {
      "description": "One entry per destination. files: placed in the cell (always): the local tray, or the cell's files/ when the local tray was not reached (ADR-0064 decisions 8 and 11). tray: the Cloudflare tray, only when the project chose it. slack: the channel in project.json's digest. Every destination is written as not done before anything is sent, so an interrupted run is not taken as done.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/destination"
      },
      "uniqueKeys": [
        "kind"
      ]
    }
  },
  "$defs": {
    "time": {
      "description": "UTC time, YYYY-MM-DDTHH:MM:SSZ.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "destination": {
      "description": "The result of one destination: when, whether it was done, and where it is (done: files' URL or path, tray's URL, slack's file id) or the reason (not done).",
      "type": "object",
      "required": [
        "kind",
        "at",
        "ok"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "The destination.",
          "enum": [
            "files",
            "tray",
            "slack"
          ]
        },
        "at": {
          "description": "When it was tried.",
          "$ref": "#/$defs/time"
        },
        "ok": {
          "description": "It was done.",
          "type": "boolean"
        },
        "url": {
          "description": "Where the owner opens it (files: the local tray's URL; tray: the Cloudflare tray's URL).",
          "type": "string",
          "pattern": "^https?://[!-~]+$"
        },
        "path": {
          "description": "files, done, when the local tray was not reached: the page's path in the cell's repo (files/<name>.html).",
          "type": "string",
          "pattern": "^files/[^/\\n\\r]+$"
        },
        "channel": {
          "description": "slack: the channel it was sent to, or was to be sent to.",
          "type": "string",
          "pattern": "^[CG][A-Z0-9]+$"
        },
        "file": {
          "description": "slack, done: the id of the uploaded file.",
          "type": "string",
          "pattern": "^[A-Z0-9]+$"
        },
        "error": {
          "description": "Why it was not done, one line.",
          "type": "string",
          "pattern": "^[^\\n\\r]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "files"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "channel"
                  ]
                },
                {
                  "required": [
                    "file"
                  ]
                },
                {
                  "required": [
                    "url",
                    "path"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tray"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "channel"
                  ]
                },
                {
                  "required": [
                    "file"
                  ]
                },
                {
                  "required": [
                    "path"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "slack"
              }
            }
          },
          "then": {
            "required": [
              "channel"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "url"
                  ]
                },
                {
                  "required": [
                    "path"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "file"
                ]
              }
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          },
          "else": {
            "required": [
              "error"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "url"
                  ]
                },
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "file"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
