{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andon.example.com/schema/gate/1",
  "title": "Gate table and gate record",
  "description": "Either a gate table (package/gate.json, or the plant's gate.local.json that replaces its keys one by one) or a gate record (tasks/<id>/library/gate/<head sha>.json, written by the courier). Only these keys.",
  "oneOf": [{ "$ref": "#/$defs/table" }, { "$ref": "#/$defs/record" }],
  "$defs": {
    "sha": { "description": "A full git commit id: 40 lowercase hex digits.", "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tier": { "description": "Tier of a change: A (low risk), B, C (the person).", "enum": ["A", "B", "C"] },
    "globs": { "description": "Path globs relative to the repository root.", "type": "array", "items": { "type": "string", "minLength": 1 } },
    "table": {
      "description": "Gate table. No key is required here, because gate.local.json holds only the keys it replaces.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size_review_lines": { "description": "Changed lines from which an independent review is required.", "type": "integer", "minimum": 0 },
        "size_human_lines": { "description": "Changed lines from which the person reviews.", "type": "integer", "minimum": 0 },
        "test_paths": { "description": "Paths that count as tests.", "$ref": "#/$defs/globs" },
        "tier_a_paths": { "description": "Paths of tier A.", "$ref": "#/$defs/globs" },
        "tier_b_paths": { "description": "Paths of tier B.", "$ref": "#/$defs/globs" },
        "tier_c_paths": { "description": "Paths of tier C.", "$ref": "#/$defs/globs" },
        "tier_c_path_exceptions": {
          "description": "For a glob in tier_c_paths, the globs it does not cover.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/globs" }
        },
        "tier_c_added_line_patterns": {
          "description": "Regular expressions; an added line matching one makes the change tier C.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "repos": {
          "description": "Per repository (host/owner/repo).",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "merge": { "description": "Merge method.", "enum": ["merge", "squash", "rebase"] },
              "strip_prefix": { "description": "Prefix removed from changed paths before matching.", "type": "string", "minLength": 1 },
              "check": { "description": "Shell commands the gate runs; each must succeed.", "type": "array", "items": { "type": "string", "minLength": 1 } },
              "tier_overrides": {
                "description": "Path glob -> tier, overriding the tier paths for this repository.",
                "type": "object",
                "additionalProperties": { "$ref": "#/$defs/tier" }
              }
            }
          }
        }
      }
    },
    "record": {
      "description": "Gate record. decision and reasons are the output of the decision function as is; the PR comment and the andon/gate commit status copy them.",
      "type": "object",
      "required": ["at", "id", "pr", "head", "tier", "tier_reasons", "changed_lines", "checks", "review", "acceptance", "delegation", "decision", "reasons", "merged"],
      "additionalProperties": false,
      "properties": {
        "at": { "description": "UTC time, YYYY-MM-DDTHH:MM:SSZ, a real calendar date and time.", "type": "string", "pattern": "^(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$" },
        "id": { "description": "Task id.", "type": "string", "pattern": "^[^/\\\\:]+$", "not": { "enum": [".", ".."] } },
        "pr": { "description": "URL of the pull request.", "type": "string", "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+/pull/[1-9][0-9]*$" },
        "head": { "description": "PR head the gate judged.", "$ref": "#/$defs/sha" },
        "tier": { "description": "Tier of the change.", "$ref": "#/$defs/tier" },
        "tier_reasons": { "description": "Why the tier, one line each.", "type": "array", "items": { "type": "string" } },
        "changed_lines": { "description": "Changed lines of the PR.", "type": "integer", "minimum": 0 },
        "checks": {
          "description": "Commands run and their results.",
          "type": "array",
          "items": {
            "type": "object", "required": ["cmd", "ok"], "additionalProperties": false,
            "properties": {
              "cmd": { "description": "The command.", "type": "string", "minLength": 1 },
              "ok": { "description": "Whether it succeeded.", "type": "boolean" }
            }
          }
        },
        "review": {
          "description": "The independent review. task and commit are required when state is current or stale, and absent when it is missing or off.",
          "type": "object", "required": ["state", "must_fix_open", "waived"], "additionalProperties": false,
          "properties": {
            "state": { "description": "current: findings.json points at head. stale: it points elsewhere. missing: none, or unreadable. off: review is off for the task.", "enum": ["current", "stale", "missing", "off"] },
            "task": { "description": "The reviewer's task id.", "type": "string", "pattern": "^[^/\\\\:]+$", "not": { "enum": [".", ".."] } },
            "commit": { "description": "commit of findings.json.", "$ref": "#/$defs/sha" },
            "must_fix_open": { "description": "Findings at must_fix or heavier not waived.", "type": "integer", "minimum": 0 },
            "waived": { "description": "Number of waived findings in report.json.", "type": "integer", "minimum": 0 }
          },
          "allOf": [
            { "if": { "properties": { "state": { "enum": ["current", "stale"] } } },
              "then": { "required": ["task", "commit"] } },
            { "if": { "properties": { "state": { "enum": ["missing", "off"] } } },
              "then": { "not": { "anyOf": [{ "required": ["task"] }, { "required": ["commit"] }] } } }
          ]
        },
        "acceptance": {
          "description": "Counts of report.json acceptance results.",
          "type": "object", "required": ["pass", "fail", "manual"], "additionalProperties": false,
          "properties": {
            "pass": { "description": "Count of pass.", "type": "integer", "minimum": 0 },
            "fail": { "description": "Count of fail.", "type": "integer", "minimum": 0 },
            "manual": { "description": "Count of manual.", "type": "integer", "minimum": 0 }
          }
        },
        "delegation": {
          "description": "The delegation's merge value read, and whether the tier is within it.",
          "type": "object", "required": ["merge", "ok"], "additionalProperties": false,
          "properties": {
            "merge": { "description": "merge of the delegation (none when there is no delegation).", "enum": ["none", "A", "B", "C"] },
            "ok": { "description": "Whether the tier is within merge.", "type": "boolean" }
          }
        },
        "decision": { "description": "Output of the decision function.", "enum": ["approve", "fix", "needs_human"] },
        "reasons": { "description": "Output of the decision function, one line each. Empty on approve.", "type": "array", "items": { "type": "string" } },
        "merged": { "description": "Whether the courier merged the PR.", "type": "boolean" }
      }
    }
  }
}
