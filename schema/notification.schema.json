{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andon.example.com/schema/notification/2",
  "title": "Dispatcher notification",
  "description": "A notification inside the dispatcher. The text in <news> is rendered from it only when it is delivered. detail depends on kind. Only these keys.",
  "type": "object",
  "required": ["at", "project", "kind", "detail"],
  "additionalProperties": false,
  "properties": {
    "at": { "description": "UTC time, YYYY-MM-DDTHH:MM:SSZ, a real calendar date and time.", "$ref": "#/$defs/time" },
    "project": { "description": "Project slug.", "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "issue": { "description": "Issue id, when the notification is about an issue.", "$ref": "#/$defs/id" },
    "kind": {
      "description": "What happened.",
      "enum": ["report", "review", "asked", "ready", "review-requested", "gate", "merged", "closed", "impact", "corrections", "signal", "blocked", "error", "finished", "stalled"]
    },
    "detail": { "description": "Depends on kind (see allOf).", "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "report" } } },
      "then": { "properties": { "detail": { "$ref": "#/$defs/report" } } } },
    { "if": { "properties": { "kind": { "const": "review" } } },
      "then": { "properties": { "detail": { "$ref": "#/$defs/review" } } } },
    { "if": { "properties": { "kind": { "const": "asked" } } },
      "then": { "properties": { "detail": { "$ref": "#/$defs/asked" } } } },
    { "if": { "properties": { "kind": { "const": "ready" } } },
      "then": { "properties": { "detail": { "$ref": "#/$defs/ready" } } } },
    { "if": { "properties": { "kind": { "const": "review-requested" } } },
      "then": { "properties": { "detail": { "$ref": "#/$defs/review-requested" } } } },
    { "if": { "properties": { "kind": { "const": "gate" } } },
      "then": { "properties": { "detail": { "$ref": "#/$defs/gate" } } } },
    { "if": { "properties": { "kind": { "const": "merged" } } },
      "then": { "properties": { "detail": { "$ref": "#/$defs/merged" } } } },
    { "if": { "properties": { "kind": { "const": "closed" } } },
      "then": { "properties": { "detail": { "$ref": "#/$defs/closed" } } } },
    { "if": { "properties": { "kind": { "const": "impact" } } },
      "then": { "properties": { "detail": { "$ref": "#/$defs/impact" } } } },
    { "if": { "properties": { "kind": { "const": "corrections" } } },
      "then": { "properties": { "detail": { "$ref": "#/$defs/corrections" } } } },
    { "if": { "properties": { "kind": { "const": "signal" } } },
      "then": { "properties": { "detail": { "$ref": "#/$defs/signal" } } } },
    { "if": { "properties": { "kind": { "enum": ["blocked", "error", "finished", "stalled"] } } },
      "then": { "properties": { "detail": { "$ref": "#/$defs/terminal" } } } }
  ],
  "$defs": {
    "time": { "description": "UTC time, YYYY-MM-DDTHH:MM:SSZ, a real calendar date and time.", "type": "string", "pattern": "^(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$" },
    "id": { "description": "A ledger issue id: no /, \\ or :, and not . or ...", "type": "string", "pattern": "^[^/\\\\:]+$", "not": { "enum": [".", ".."] } },
    "path": { "description": "An absolute path.", "type": "string", "pattern": "^/" },
    "pr": { "description": "URL of a pull request; owner and repo are printable ASCII without /.", "type": "string", "pattern": "^https://github\\.com/[!-.0-~]+/[!-.0-~]+/pull/[1-9][0-9]*$" },
    "report": {
      "description": "kind report: from {\"report\": \"write\" | \"append\"} in log.jsonl.",
      "type": "object", "required": ["report"], "additionalProperties": false,
      "properties": { "report": { "description": "Path of report.md.", "$ref": "#/$defs/path" } }
    },
    "review": {
      "description": "kind review: from {\"status\": \"review\"}.",
      "type": "object", "required": ["report", "pr"], "additionalProperties": false,
      "properties": {
        "report": { "description": "Path of report.md.", "$ref": "#/$defs/path" },
        "pr": { "description": "From report.json.", "$ref": "#/$defs/pr" }
      }
    },
    "asked": {
      "description": "kind asked: from {\"question\": n, \"status\": \"open\"}, filled from the question JSON.",
      "type": "object", "required": ["n", "kind", "question"], "additionalProperties": false,
      "properties": {
        "n": { "description": "Question number in the issue.", "type": "integer", "minimum": 1 },
        "kind": { "description": "As in question.json.", "enum": ["business", "users", "promise", "irreversible", "line", "scope"] },
        "question": { "description": "As in question.json.", "type": "string", "minLength": 1 }
      }
    },
    "ready": {
      "description": "kind ready: an issue that became ready since last time (person issues excluded).",
      "type": "object", "required": ["title"], "additionalProperties": false,
      "properties": {
        "title": { "description": "Issue title.", "type": "string" },
        "routine": { "description": "Routine that added the issue, if any.", "type": "string", "minLength": 1 }
      }
    },
    "review-requested": {
      "description": "kind review-requested: the dispatcher started a reviewer for review_request.",
      "type": "object", "required": ["round", "reviewer", "reviewer_issue"], "additionalProperties": false,
      "properties": {
        "round": { "description": "As in review_request.", "type": "integer", "minimum": 1 },
        "reviewer": { "description": "Reviewer profile.", "enum": ["codex-review", "claude-review"] },
        "reviewer_issue": { "description": "The reviewer's issue id.", "$ref": "#/$defs/id" }
      }
    },
    "gate": {
      "description": "kind gate: the result of `andon gate` run by the dispatcher.",
      "type": "object", "required": ["decision", "reasons", "record"], "additionalProperties": false,
      "properties": {
        "decision": { "description": "As in the gate record.", "enum": ["approve", "fix", "needs_human"] },
        "reasons": { "description": "As in the gate record.", "type": "array", "items": { "type": "string" } },
        "record": { "description": "Path of the gate record.", "$ref": "#/$defs/path" }
      }
    },
    "merged": {
      "description": "kind merged: the dispatcher merged and finished the issue, or (by: person) found that a person merged an issue in review and finished it. held: it did not finish, and why.",
      "type": "object", "required": ["pr", "sha"], "additionalProperties": false,
      "if": { "required": ["held"] }, "then": { "required": ["by"] },
      "properties": {
        "pr": { "description": "The merged pull request.", "$ref": "#/$defs/pr" },
        "sha": { "description": "The merge commit.", "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "by": { "description": "Only when a person merged on GitHub (absent when the dispatcher merged).", "const": "person" },
        "held": { "description": "Why the dispatcher did not finish the issue (an open question not from the gate, or finish failed).", "type": "string", "minLength": 1 }
      }
    },
    "closed": {
      "description": "kind closed: the pull request of an issue in review was closed without merging. Not finished; notified once.",
      "type": "object", "required": ["pr"], "additionalProperties": false,
      "properties": { "pr": { "description": "The closed pull request.", "$ref": "#/$defs/pr" } }
    },
    "signal": {
      "description": "kind signal: a signal of weight now seen for the first time in an episode (copied from the signal record, schema/signal.schema.json).",
      "type": "object",
      "required": ["source", "key", "url", "title", "weight"],
      "additionalProperties": false,
      "properties": {
        "source": { "description": "As in the signal record.", "enum": ["github-ci", "github-issues", "sentry", "linear", "cloudflare"] },
        "key": { "description": "As in the signal record.", "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
        "url": { "description": "As in the signal record.", "type": "string", "pattern": "^https://[!-~]+$" },
        "title": { "description": "As in the signal record. Untrusted: rendered inside the untrusted fence.", "type": "string", "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
        "weight": { "description": "As in the signal record.", "enum": ["now", "later"] }
      }
    },
    "corrections": {
      "description": "kind corrections: the dispatcher could not collect a finished issue's corrections.json (after one retry) and did not write it.",
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": { "description": "Why it gave up.", "type": "string", "minLength": 1 }
      }
    },
    "impact": {
      "description": "kind impact: from `andon issue impact` after an issue's PR was merged. Only the running issues it may affect; the Chief of Staff judges. When the facts could not be collected, only pr and error.",
      "type": "object", "required": ["pr"], "additionalProperties": false,
      "oneOf": [
        { "required": ["sha", "issues"], "not": { "required": ["error"] } },
        { "required": ["error"], "not": { "anyOf": [{ "required": ["sha"] }, { "required": ["issues"] }] } }
      ],
      "properties": {
        "pr": { "description": "The merged pull request.", "$ref": "#/$defs/pr" },
        "error": { "description": "Why the dispatcher gave up collecting the facts (after retries).", "type": "string", "minLength": 1 },
        "sha": { "description": "The merge commit.", "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "issues": {
          "description": "Running issues in the same repo that conflict, overlap, are referenced by the brief, or could not be read.",
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["issue", "conflict", "overlap", "brief_refs"], "additionalProperties": false,
            "properties": {
              "issue": { "description": "Issue id.", "$ref": "#/$defs/id" },
              "conflict": { "description": "git merge-tree of the branch and the merge commit conflicts.", "type": "boolean" },
              "overlap": { "description": "Files both changed (at most 20).", "type": "array", "items": { "type": "string", "minLength": 1 } },
              "brief_refs": { "description": "Merged files named in the issue's brief (at most 20).", "type": "array", "items": { "type": "string", "minLength": 1 } },
              "error": { "description": "Why the facts could not be read.", "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "terminal": {
      "description": "kind blocked, error, finished, stalled: the terminal host's state. No screen text.",
      "type": "object", "required": ["agent", "status_ms"], "additionalProperties": false,
      "properties": {
        "agent": { "description": "Terminal address.", "type": "string", "minLength": 1 },
        "status_ms": { "description": "status_ms of the terminal host: Unix time in milliseconds when it entered this state.", "type": "integer", "minimum": 0 }
      }
    }
  }
}
