#!/usr/bin/env bash
# tests/run [--changed [<base>]]
#
# tests/*.sh を並べて走らせ、1本ごとの所要時間の表を出す（tests/lib/run-tests.sh）。並べる数は ANDON_TEST_JOBS（既定は nproc）。
#   引数なし         全部。
#   --changed [base] 変えたものに関係する検査だけ（tests/lib/scope.sh。image の検査は image に関係するときだけ）。
#                    変えたものは <base>（既定は origin/main との merge-base）からの差分と、未 commit・未追跡のファイル。
# 手元では --changed、全部は CI に任せる。go test ./... は別に打つ。
# 同時に走るのは1本だけ（mise の置き場と CPU を取り合う）。鍵のファイル（ANDON_TEST_LOCK。既定は /tmp/andon-tests-run.lock。
# worktree をまたいで同じもの）を flock で取り、ほかの回が持っていれば理由を1行出して、その回が終わるまで待つ。
set -euo pipefail
cd "$(dirname "$0")/.."

case "${1:-}" in
  '' | --changed) ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac

# 鍵はこの shell が持ち、検査には渡さない（9>&-）。検査が裏に残したプロセスが鍵を持ち続けて、次の回が止まらないように。
# 鍵を持つ回が落ちれば鍵は外れる（ファイルは残るが、中身はその回の控えで、次の回が書き直す）
lock=${ANDON_TEST_LOCK:-/tmp/andon-tests-run.lock}
exec 9>>"$lock"
if ! flock -n 9; then
  echo "tests/run: ほかの tests/run（$(cat "$lock" 2>/dev/null || true)）が走っている。終わるまで待つ" >&2
  flock 9
fi
echo "pid $$ $PWD" >"$lock"

if [ "$#" -eq 0 ]; then
  bash tests/lib/run-tests.sh 9>&-
  exit
fi
base=${2:-$(git merge-base HEAD origin/main)}
changed=$( {
  git diff --name-only --no-renames "$base"
  git ls-files --others --exclude-standard
} | sort -u)
mapfile -t tests < <(bash tests/lib/scope.sh <<<"$changed")
echo "変えたもの（$(git rev-parse --short "$base") から）: $(grep -c . <<<"$changed" || true) 個 → 走らせる: ${tests[*]}"
bash tests/lib/run-tests.sh "${tests[@]}" 9>&-
