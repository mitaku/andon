#!/usr/bin/env bash
# tests/isolation [<tests/x.sh>...]
#
# 検査がセルの本物（kanban・HOME）に書かないことを確かめる。手で打つ（全部を回すので数分かかる。tests/run は拾わない）。
# 一時ディレクトリに偽のセル（番兵）を作り、セルと同じ形にして go test ./... と tests/*.sh を回す:
#   - repo の写し（今の作業ツリーごと）を <ws>/.ghq/example.com/owner/andon に置き、
#     その repo を repos に持つ kanban <ws>/projects/sample/kanban を置く（git の main checkout から kanban を探す道）。
#   - KANBAN_ROOT・HOME・CLAUDE_CONFIG_DIR・ANDON_HOME・CODEX_HOME・ANDON_WORKSPACE・GHQ_ROOT・XDG_STATE_HOME・XDG_CONFIG_HOME・
#     XDG_DATA_HOME・HC_* を番兵へ向ける（XDG_* は番兵の HOME の下。セルで値があってもなくても同じ置き場を見る）。
#   - TMPDIR を repo の写しの中に置く（担当が一時ディレクトリを worktree の中に置いたときと同じ）。
# 番兵（セルの repo の根 <ws> の下。repo の写しと go の telemetry を除く）のファイルが1つでも変われば、変わったものを出して 1 で終わる。
#   出すのは、増えた・消えた・変わったパスを上から4段のフォルダごとに数えたまとめ（40 か所まで。超えるときは、か所の多いフォルダから
#   1つ上にまとめる）と、全部の差分を残したファイル（${TMPDIR:-/tmp}/isolation.XXXXXX。消さない）のパス。
#   数千のファイルが増えても、どの置き場に書いたかが1画面で分かる。GitHub Actions では、全部を畳んだ group でログにも出す。
# kanban と HOME のほか、ANDON_WORKSPACE（<ws>）と GHQ_ROOT（<ws>/.ghq）の下に書いたものも見る。検査の失敗も 1。
# 番兵のファイルを読んだ検査も、読んだファイルを出して 1 で終わる。セルの本物の置き場の中身（空の memory の目録など）で
# 手元の検査が落ちるのを防ぐ。読んだかは atime で見る: 検査の前に番兵のファイルの atime を古い時刻へ戻す
# （relatime でも、atime が mtime・ctime より古いファイルは読むと atime が動く）。atime が動かない置き場では落ちる。
# 番兵には本物のセルで起きた形も置く（中身が空の memory の目録・壊れた JSON の plugin の控え）。
# 動いているローカルの tray の控え（serve.json）も置く。ANDON_TRAY_OFF の切りを外した検査は、報告を送る前に控えを読むので落ちる
# （ADR-0064 決めたこと 15・受け入れ条件 16）。宛先は閉じた番号で、読んでも届かない。
# 引数があれば tests/*.sh はそれだけ（go test ./... は毎回回す）。
set -euo pipefail
src=$(cd "$(dirname "$0")/.." && pwd)
tmp=$(mktemp -d)
trap 'chmod -R u+w "$tmp" 2>/dev/null; rm -rf "$tmp"' EXIT

# 道具は本物の置き場のまま使う（HOME を替える前に決める。go と node のキャッシュは番兵の外）。
# mise があれば mise which を先に聞く。command -v が返すのは shim のことがあり、shim は番兵の HOME へ道具を入れ直す
gobin=$(cd "$src" && mise which go 2>/dev/null || command -v go || true)
[ -n "$gobin" ] || { echo "FAIL go が無い" >&2; exit 1; }
nodebin=$(cd "$src" && mise which node 2>/dev/null || command -v node || true)
path="$(dirname "$gobin")${nodebin:+:$(dirname "$nodebin")}:$PATH"
gocache=$(PATH=$path go env GOCACHE) gomodcache=$(PATH=$path go env GOMODCACHE)

ws=$tmp/ws
repo=$ws/.ghq/example.com/owner/andon
mkdir -p "$ws/.ghq/example.com/owner" "$ws/projects/sample" "$ws/home/.local/state" "$ws/home/.local/share" "$ws/home/.claude/plugins" "$ws/home/.codex" "$ws/home/.config/go" "$ws/memory"
git clone -q "$src" "$repo"
(cd "$src" && git diff HEAD --binary) | (cd "$repo" && git apply --allow-empty)
# 未追跡のファイルも写す。この回の一時の置き場（TMPDIR が作業ツリーの中なら、その下に番兵と repo の写しがある）は除く
own=()
case "$(cd "$tmp" && pwd -P)/" in "$(cd "$src" && pwd -P)"/*) own=(":(exclude)$(realpath --relative-to="$src" "$tmp")") ;; esac
(cd "$src" && git ls-files --others --exclude-standard -z -- . "${own[@]}") | (cd "$src" && xargs -0r cp --parents -t "$repo")
(cd "$ws/projects/sample" && env -u KANBAN_ROOT PATH="$path" HC_TERMINAL_ID=t1 bash -c '
  kanban init --prefix S --repo example.com/owner/andon >/dev/null
  kanban add "番兵の課題" >/dev/null
  kanban config set chief_of_staff=t1 >/dev/null')
printf '# 番兵\n' >"$ws/home/.claude/CLAUDE.md"
printf '{}\n' >"$ws/home/.claude/settings.json"
printf '# 番兵\n' >"$ws/home/.codex/config.toml"
printf '# 番兵\n' >"$ws/AGENTS.local.md"
: >"$ws/memory/MEMORY.md"                                # 中身が空の memory の目録（本物のセルで起きた形）
printf '{"version": 2, "plugins": {\n' >"$ws/home/.claude/plugins/installed_plugins.json" # 壊れた JSON
mkdir -p "$ws/home/.local/state/andon/tray"
printf '{"list": "http://127.0.0.1:9", "upload": "http://127.0.0.1:9", "list_origin": "http://tray.sentinel.localhost:1355", "view_origin": "http://tray-view.sentinel.localhost:1355", "pid": 1}\n' \
  >"$ws/home/.local/state/andon/tray/serve.json"
mkdir -p "$repo/tests/.task-tmp"
# 一時置き場は写しの git から外す。git ls-files --others で tests/ を数える検査が、並んで走る検査の作っては消すファイルを拾わないように
printf '/tests/.task-tmp/\n' >>"$repo/.git/info/exclude"

# 数えないのは、検査が動く repo の写し（TMPDIR もこの中）と、go の道具が自分で書く telemetry（~/.config/go。検査ではなく go が書く）だけ
skip=(-path ./.ghq/example.com/owner/andon -prune -o -path ./home/.config/go -prune -o)
snap() { (cd "$ws" && find . "${skip[@]}" -print0 | sort -z | xargs -0 stat -c '%n %F %s %Y' &&
  find . "${skip[@]}" -type f -print0 | sort -z | xargs -0 sha256sum); }
before=$(snap)

# 読みの検査の支度。snap が番兵を読んだあとで atime を古い時刻へ戻す。まず atime が動く置き場かを確かめる
old=200001010000
probe=$tmp/atime-probe
printf 'x\n' >"$probe" && touch -a -t "$old" "$probe"
oldat=$(stat -c %X "$probe")
cat "$probe" >/dev/null
if [ "$(stat -c %X "$probe")" = "$oldat" ]; then
  echo "FAIL 一時の置き場（$tmp）は読んでも atime が動かない（noatime など）。番兵を読んだかを確かめられない" >&2
  exit 1
fi
# 見るのは今あるファイルだけ（検査が足したファイル・消したファイルは書いたほうの検査で出る）
(cd "$ws" && find . "${skip[@]}" -type f -print0) >"$tmp/sentinel-files"
(cd "$ws" && xargs -0r touch -a -t "$old" <"$tmp/sentinel-files")
readfiles() { (cd "$ws" && xargs -0r stat -c '%X %n' 2>/dev/null <"$tmp/sentinel-files" || true) |
  while read -r at name; do [ "$at" = "$oldat" ] || echo "$name"; done; }

cell=(env PATH="$path" GOCACHE="$gocache" GOMODCACHE="$gomodcache" TMPDIR="$repo/tests/.task-tmp"
  KANBAN_ROOT="$ws/projects/sample" HOME="$ws/home" CLAUDE_CONFIG_DIR="$ws/home/.claude" CODEX_HOME="$ws/home/.codex"
  ANDON_HOME="$ws/home" ANDON_WORKSPACE="$ws" GHQ_ROOT="$ws/.ghq"
  XDG_STATE_HOME="$ws/home/.local/state" XDG_CONFIG_HOME="$ws/home/.config" XDG_DATA_HOME="$ws/home/.local/share"
  HC_TERMINAL_ID=t1 HC_SCOPE=sentinel HC_TERMINAL_SOCKET="$ws/hc.sock")
failed=0
(cd "$repo" && "${cell[@]}" go test ./...) || failed=1
(cd "$repo" && "${cell[@]}" bash tests/lib/run-tests.sh "$@") || failed=1

read=$(readfiles) # snap が読む前に見る
after=$(snap)

# 番兵に書いた・読んだときは、全部をファイルに残し（$tmp は終わりに消すので外に置く）、画面にはまとめを $max 行まで出す。
# 数千のファイルが増えても、どの置き場に書いたかが1画面で分かるように
max=40
keep=''
# 一時の置き場に書けなければ、全部を画面（stderr）に出す（まとめのために全部を捨てない）
keepfile() { [ -n "$keep" ] || keep=$(mktemp "${TMPDIR:-/tmp}/isolation.XXXXXX" 2>/dev/null) || keep=/dev/stderr; }
# diff の < と > の行からパスを取り、増えた（> だけ）・消えた（< だけ）・変わった（両方）に分けて、上から4段のフォルダごとに数える。
# か所が $max を超えるあいだ、か所を一番多く抱えるフォルダだけを1つ上にまとめる（小さな書き込みが「ほか」に隠れないように。
# 段を一律に浅くすると、別の置き場への1ファイルが同じ上のフォルダの大きな塊に溶けるので、ほかの置き場の細かさは落とさない）。
# 読めない行（stat の種類を知らない・名前に改行がある）は数えて出す（黙って落とさない）。
# 出すのは1行目に「<まとめた回数> <増えた> <消えた> <変わった> <読めない行>」、2行目から「<計> <増えた> <消えた> <変わった> <フォルダ>」
changes() {
  sed -nE -e 's/^([<>]) [0-9a-f]{64}  (.*)$/\1 \2/p; t' \
    -e 's/^([<>]) (.*) (regular file|regular empty file|directory|symbolic link|fifo|socket|character special file|block special file|weird file) [0-9]+ [0-9]+$/\1 \2/p; t' \
    -e 's/^[<>] .*/?/p' |
    awk -v max="$max" '
      $0 == "?" { bad++; next }
      { p = substr($0, 3); if (substr($0, 1, 1) == "<") a[p] = 1; else b[p] = 1; all[p] = 1 }
      function group(p,   x, n, g, i) { n = split(p, x, "/"); g = x[1]; for (i = 2; i <= n && i <= 5; i++) g = g "/" x[i]; return g }
      function up(q) { if (q == ".") return ""; sub(/\/[^\/]*$/, "", q); return q }
      END {
        for (p in all) g[p] = group(p)
        m = 0
        while (1) {
          split("", seen); split("", kids); k = 0
          for (p in all) if (!(g[p] in seen)) { seen[g[p]] = 1; k++ }
          if (k <= max) break
          # か所を一番多く抱えるフォルダだけを1つ上にまとめる（ほかの置き場の細かさは落とさない）
          for (q in seen) { u = up(q); if (u != "") kids[u]++ }
          best = ""; bn = 1
          for (u in kids) if (kids[u] > bn || (kids[u] == bn && best != "" && u < best)) { best = u; bn = kids[u] }
          if (best == "") break
          for (p in all) if (up(g[p]) == best) g[p] = best
          m++
        }
        for (p in all) {
          t = (p in a) ? ((p in b) ? "c" : "r") : "n"
          cnt[g[p], t]++; tot[g[p]]++; T[t]++
        }
        printf "%d %d %d %d %d\n", m, T["n"], T["r"], T["c"], bad
        for (q in tot) printf "%d %d %d %d %s\n", tot[q], cnt[q, "n"], cnt[q, "r"], cnt[q, "c"], q
      }'
}
wrote='' readmsg=''
if [ "$before" != "$after" ]; then
  keepfile
  { echo "# 検査が番兵に書いた（番兵の前と後の diff。< が前、> が後）"; diff <(echo "$before") <(echo "$after") || true; } >>"$keep"
  sum=$(diff <(echo "$before") <(echo "$after") | changes || true)
  read -r merged n r c bad <<<"$(sed -n 1p <<<"$sum")"
  places=$(sed 1d <<<"$sum" | sort -k1,1nr -k5)
  k=$(grep -c . <<<"$places" || true)
  wrote=$(
    echo "FAIL 検査が番兵（セルの本物の代わり）に書いた: 増えた $n・消えた $r・変わった $c（上から4段のフォルダごと。多い順）"
    [ "${merged:-0}" = 0 ] || echo "  か所が $max を超えたので、か所の多いフォルダを1つ上のフォルダにまとめた（$merged 回）"
    [ "$k" = 0 ] || head -n "$max" <<<"$places" | while read -r _ pn pr pc g; do printf '  増えた %6d  消えた %6d  変わった %6d  %s\n' "$pn" "$pr" "$pc" "$g"; done
    [ "$k" -le "$max" ] || echo "  ほか $((k - max)) か所"
    [ "${bad:-0}" = 0 ] || echo "  読めない行 $bad（全部の差分で見る）"
    echo "  全部の差分: $keep"
  )
  failed=1
else
  echo "ok   番兵（kanban projects/sample・HOME・セルの repo の根・GHQ_ROOT）は変わらなかった"
fi
if [ -n "$read" ]; then
  keepfile
  { echo "# 検査が読んだ番兵のファイル"; echo "$read"; } >>"$keep"
  k=$(grep -c . <<<"$read")
  readmsg=$(
    echo "FAIL 検査が番兵（セルの本物の代わり）のファイルを読んだ（検査の環境で置き場を一時に向ける）: $k 件"
    head -n "$max" <<<"$read" | sed 's/^/  /'
    [ "$k" -le "$max" ] || echo "  ほか $((k - max)) 件"
    echo "  全部: $keep"
  )
  failed=1
else
  echo "ok   番兵のファイルは読まれなかった"
fi
# CI（GitHub Actions）では一時の置き場が job と一緒に消えるので、全部を畳んだ group でログにも出す。まとめはその後ろ（ログの終わり）に出す
if [ -n "$keep" ] && [ -f "$keep" ] && [ "${GITHUB_ACTIONS:-false}" = true ]; then
  { echo "::group::全部の差分（$keep）"; cat "$keep"; echo "::endgroup::"; } >&2
fi
[ -z "$wrote" ] || echo "$wrote" >&2
[ -z "$readmsg" ] || echo "$readmsg" >&2
[ "$failed" = 0 ] || { echo "FAIL 検査が落ちた（上の出力）" >&2; exit 1; }
