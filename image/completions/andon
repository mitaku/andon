# bash completion for andon（サブコマンド名だけ。フラグまでは補わない）。image/Dockerfile が /usr/share/bash-completion/completions/ に置く
_andon() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  if [ "$COMP_CWORD" -eq 2 ] && [ "${COMP_WORDS[1]}" = open ]; then
    local ws=${ANDON_WORKSPACE:-/workspace} d s=
    for d in "$ws"/projects/*/kanban/config.yaml; do
      [ -e "$d" ] && s="$s $(basename "$(dirname "$(dirname "$d")")")"
    done
    COMPREPLY=($(compgen -W "$s" -- "$cur"))
    return 0
  fi
  [ "$COMP_CWORD" -eq 1 ] || return 0
  COMPREPLY=($(compgen -W "issue chief-of-staff create open chief-engineer dispatcher news publish triage signal measure process boot init gate delegate help" -- "$cur"))
}
complete -F _andon andon
